<Window x:Class="SSEN_Seat_Reservation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="스터디카페 좌석 예약" Height="620" Width="980"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Window.Resources>
        <Style x:Key="SeatButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#E8F5E9"/>
            <Setter Property="BorderBrush" Value="#66BB6A"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Reserved">
                    <Setter Property="Background" Value="#FFF3E0"/>
                    <Setter Property="BorderBrush" Value="#FFA726"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="InUse">
                    <Setter Property="Background" Value="#FFEBEE"/>
                    <Setter Property="BorderBrush" Value="#EF5350"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderThickness" Value="5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <ItemsPanelTemplate x:Key="HorizontalSeatPanel">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>

        <DataTemplate x:Key="SeatTemplate">
            <Button Style="{StaticResource SeatButtonStyle}"
                    Command="{Binding DataContext.SelectSeatCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    CommandParameter="{Binding}">
                <Grid ClipToBounds="True" Margin="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="12"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding Number, StringFormat={}{0}번}"
                               FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="1" Text="{Binding StatusText}" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="2" Text="{Binding UserName}" FontSize="8"
                               Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="3" Text="{Binding TimeText}" FontSize="8"
                               Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,16,0">
            <StackPanel DockPanel.Dock="Top" Margin="6,0,6,10">
                <TextBlock Text="스터디카페 좌석 현황" FontSize="22" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border Width="14" Height="14" Background="#E8F5E9" BorderBrush="#66BB6A" BorderThickness="2" CornerRadius="3"/>
                    <TextBlock Text=" 빈자리" Margin="0,0,14,0"/>
                    <Border Width="14" Height="14" Background="#FFF3E0" BorderBrush="#FFA726" BorderThickness="2" CornerRadius="3"/>
                    <TextBlock Text=" 예약중" Margin="0,0,14,0"/>
                    <Border Width="14" Height="14" Background="#FFEBEE" BorderBrush="#EF5350" BorderThickness="2" CornerRadius="3"/>
                    <TextBlock Text=" 이용중" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding SeatCountsText}" Foreground="Gray" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/><ColumnDefinition Width="72"/><ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="72"/><ColumnDefinition Width="72"/><ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="72"/><ColumnDefinition Width="72"/><ColumnDefinition Width="72"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ItemsControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding Row1Section1}" ItemsPanel="{StaticResource HorizontalSeatPanel}" ItemTemplate="{StaticResource SeatTemplate}"/>
                <ItemsControl Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" ItemsSource="{Binding Row1Section2}" ItemsPanel="{StaticResource HorizontalSeatPanel}" ItemTemplate="{StaticResource SeatTemplate}"/>
                <ItemsControl Grid.Row="0" Grid.Column="6" Grid.ColumnSpan="3" ItemsSource="{Binding Row1Section3}" ItemsPanel="{StaticResource HorizontalSeatPanel}" ItemTemplate="{StaticResource SeatTemplate}"/>

                <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding Row2Section1}" ItemsPanel="{StaticResource HorizontalSeatPanel}" ItemTemplate="{StaticResource SeatTemplate}"/>
                <ItemsControl Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" ItemsSource="{Binding Row2Section2}" ItemsPanel="{StaticResource HorizontalSeatPanel}" ItemTemplate="{StaticResource SeatTemplate}"/>
                <ItemsControl Grid.Row="1" Grid.Column="6" Grid.ColumnSpan="3" ItemsSource="{Binding Row2Section3}" ItemsPanel="{StaticResource HorizontalSeatPanel}" ItemTemplate="{StaticResource SeatTemplate}"/>

                <ItemsControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding Row3Section1}" ItemsPanel="{StaticResource HorizontalSeatPanel}" ItemTemplate="{StaticResource SeatTemplate}"/>
                <ItemsControl Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" ItemsSource="{Binding Row3Section2}" ItemsPanel="{StaticResource HorizontalSeatPanel}" ItemTemplate="{StaticResource SeatTemplate}"/>
                <ItemsControl Grid.Row="2" Grid.Column="6" Grid.ColumnSpan="3" ItemsSource="{Binding Row3Section3}" ItemsPanel="{StaticResource HorizontalSeatPanel}" ItemTemplate="{StaticResource SeatTemplate}"/>

                <ItemsControl Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2" ItemsSource="{Binding Row4Section1}" ItemsPanel="{StaticResource HorizontalSeatPanel}" ItemTemplate="{StaticResource SeatTemplate}"/>
                <ItemsControl Grid.Row="3" Grid.Column="6" Grid.ColumnSpan="3" ItemsSource="{Binding Row4Section2}" ItemsPanel="{StaticResource HorizontalSeatPanel}" ItemTemplate="{StaticResource SeatTemplate}"/>
                <ItemsControl Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2" ItemsSource="{Binding Row5Section1}" ItemsPanel="{StaticResource HorizontalSeatPanel}" ItemTemplate="{StaticResource SeatTemplate}"/>
                <ItemsControl Grid.Row="4" Grid.Column="6" Grid.ColumnSpan="3" ItemsSource="{Binding Row5Section2}" ItemsPanel="{StaticResource HorizontalSeatPanel}" ItemTemplate="{StaticResource SeatTemplate}"/>
            </Grid>
        </DockPanel>

        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18"
                BorderBrush="#DDD" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="좌석 정보" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="{Binding SelectedSeatText}" FontSize="15"
                           Margin="0,12,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedSeatDetails}" Foreground="Gray"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="DarkSlateBlue"
                           Margin="0,8,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="이름" Margin="0,20,0,4"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Height="32" FontSize="14" VerticalContentAlignment="Center"/>

                <Button Content="예약하기" Command="{Binding ReserveCommand}"
                        Style="{StaticResource ActionButtonStyle}" Margin="0,16,0,0"/>
                <Button Content="입실 (이용 시작)" Command="{Binding CheckInCommand}"
                        Style="{StaticResource ActionButtonStyle}"/>
                <Button Content="예약 취소" Command="{Binding CancelCommand}"
                        Style="{StaticResource ActionButtonStyle}"/>
                <Button Content="퇴실" Command="{Binding CheckOutCommand}"
                        Style="{StaticResource ActionButtonStyle}"/>

                <TextBlock Text="※ 예약 후 10분 안에 입실하지 않으면 예약이 자동 취소됩니다."
                           Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
